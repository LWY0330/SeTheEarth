# See Earth · example environment variables
# Copy to .env.local for development overrides.

# ─── Weather provider ───
# Values: "open-meteo" | "mock"
# open-meteo is CORS-friendly, key-free, free for non-commercial use.
# mock returns deterministic fixtures for offline / CI / e2e tests.
WEATHER_API_PROVIDER=mock

# ─── Sun provider ───
# Values: "sunrise-sunset" | "hour-bucket"
# sunrise-sunset calls api.sunrise-sunset.org/json (key-free).
# hour-bucket skips the API and uses pure hour-based dayPeriod.
SUN_PROVIDER=sunrise-sunset

# ─── Server ───
# Used by `npm run start` (serve -s dist -l 8080)
PORT=8080
HOST=0.0.0.0

# ─── Feature flags ───
# v1.6.3 · PROMPT 44 v1 · Phase 2 收口
# Universal CityPage 启用开关:
#   true  → /cities/:slug 渲染 UniversalCityPage(Phase 2 收口组件)
#   false → 保留 legacy v1.4 CityPage(默认;生产环境)
VITE_USE_UNIVERSAL_CITYPAGE=false
