{
  "name": "see-earth",
  "private": true,
  "version": "1.1.0-rc.1",
  "type": "module",
  "description": "看见地球 — A timeline-driven journey across Earth's history (v1.1 real-data sprint)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "serve -s dist -l 8080",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lighthouse": "bash scripts/lighthouse-ci.sh",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts src/types/*.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
